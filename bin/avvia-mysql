#!/usr/bin/env bash
# Avvia MySQL 8 + phpMyAdmin (Docker) ed entra nel prompt mysql>.
# I file creati con "tee" finiscono nella cartella mostrata all'avvio (di solito ~/Documents/mysql).
#
#   avvia-mysql                   prompt interattivo
#   avvia-mysql -p                se hai messo una password a root
#   avvia-mysql < esercizio.sql   esegue un file e esce
set -e

if ! docker info >/dev/null 2>&1; then
    if ! docker info 2>&1 | grep -qi "permission denied"; then
        echo "Docker è spento. Avvialo con:  sudo systemctl enable --now docker" >&2
    else
        echo "Non hai i permessi per usare Docker." >&2
        echo "Hai fatto logout/login dopo l'installazione? (vedi docs/problemi-comuni.md)" >&2
    fi
    exit 1
fi

if ! docker container inspect mysql-scuola >/dev/null 2>&1; then
    echo "Il container mysql-scuola non esiste. Lancia prima ./install.sh" >&2
    exit 1
fi

# Spegne XAMPP solo se sta girando (usa le stesse porte 80 e 3306).
# Così sudo viene chiesto solo quando serve davvero.
# Niente "lampp status": se trova vecchi .pid di root, il suo rm si ferma
# a chiedere conferma e il comando sembra bloccato.
if pgrep -f '^/opt/lampp/s?bin/(httpd|mysqld|mariadbd)' >/dev/null; then
    echo "XAMPP è acceso: lo spengo per liberare le porte 80 e 3306..." >&2
    sudo /opt/lampp/lampp stop
fi

docker start mysql-scuola pma-scuola >/dev/null

printf "Attendo che MySQL sia pronto" >&2
for _ in $(seq 1 60); do
    docker exec mysql-scuola mysqladmin ping -h 127.0.0.1 -u root --silent >/dev/null 2>&1 && break
    printf "." >&2; sleep 1
done
echo " ok!" >&2

# Se ~/Documents/mysql è stata cancellata, Docker la ricrea come root:
# la restituiamo al tuo utente, altrimenti il tee non può scriverci.
WORK=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/work"}}{{.Source}}{{end}}{{end}}' mysql-scuola)
if [ -d "$WORK" ] && [ ! -O "$WORK" ]; then
    docker exec -u 0 mysql-scuola chown "$(id -u):$(id -g)" /work
fi

if [ -t 0 ]; then
    if docker port pma-scuola 2>/dev/null | grep -q ':80$'; then
        PMA="http://localhost/phpmyadmin"
    else
        PMA="http://localhost:8080"
    fi
    echo "   phpMyAdmin: $PMA   |   file del tee in: ${WORK/#$HOME/\~}" >&2
    TTY=(-it)
else
    TTY=(-i)   # input da file/pipe: niente terminale interattivo
fi

# Gira come il tuo utente, così i file del tee sono tuoi e non di root
exec docker exec "${TTY[@]}" -u "$(id -u):$(id -g)" -e HOME=/tmp -w /work \
    mysql-scuola mysql -h 127.0.0.1 -u root "$@"
